# Base URL of the backend API.
# - Local dev, or when the server also serves this build: leave as /api
#   (the Vite dev server proxies /api to http://localhost:3000).
# - Client hosted separately (e.g. Vercel): the API's full URL, e.g.
#   https://hush-api.onrender.com/api  (and set CLIENT_URL on the server).
VITE_API_BASE_URL=/api
