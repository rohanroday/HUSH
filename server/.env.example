# Copy to .env (never commit the real one) and fill in.

# MongoDB connection string, including the database name
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hush

# Long random string used to sign login tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ImageKit private key (dashboard > Developer options), used for product photos
IMAGEKIT_API_KEY=

# Razorpay API keys (use rzp_test_ keys until you're ready to take real money)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set to production when deployed
NODE_ENV=development

# Port to listen on (most hosts set this for you)
PORT=3000

# Only if the client is hosted on a different domain than the API:
# comma-separated list of allowed origins, e.g. https://hush.vercel.app
CLIENT_URL=

# Number of reverse proxies in front of the app (defaults: 3 on Render, 1
# elsewhere). Only set this if the request logs show 10.x.x.x addresses.
# TRUST_PROXY=
